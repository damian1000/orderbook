[Unit]
Description=Order book matching engine and web front end
After=network.target

[Service]
Environment=JAVA_HOME=/opt/jdk25
Environment=JAVA_OPTS=-Xmx256m
Environment=PORT=8080
# Box-local egress config (KAFKA_BOOTSTRAP_SERVERS etc.); optional - absent means egress off.
EnvironmentFile=-/etc/orderbook/egress.env
ExecStart=/home/ubuntu/orderbook/bin/orderbook
Restart=on-failure
RestartSec=2
User=ubuntu

# Sandboxing. This service is reachable from the internet and holds the Kafka SCRAM credential,
# so the blast radius of a defect in it is worth bounding. It writes nothing to disk — the book
# is in memory and everything durable leaves over Kafka — so the whole filesystem is read-only
# and it needs no ReadWritePaths at all. `systemd-analyze security orderbook.service` reports it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# MemoryDenyWriteExecute is deliberately absent rather than set false, so it does not get added
# later: the JVM writes JIT-compiled code and then executes it, and enabling it kills the process
# at the first compilation.
#
# Sized from the observed peak (79 MB) and the 256 MB heap, not from either alone. The point is to
# bound a runaway into a restart rather than let one tenant of a 1 GB box take the others with it.
MemoryMax=512M
TasksMax=512

[Install]
WantedBy=multi-user.target
